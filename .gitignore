# 凭证与密钥（绝不 commit）
auths/*
!auths/.gitkeep
data/*
!data/.gitkeep
config.json
.env
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# 本地 md 不入库（README 除外）
*.md
!README.md

# IDE
.idea/
.vscode/
